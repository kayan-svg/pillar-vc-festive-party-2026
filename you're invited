function setup() {
  createCanvas(windowWidth, windowHeight);
  buildArm();
  buildTextDots();
  layout();
}

function windowResized() {
  resizeCanvas(windowWidth, windowHeight);
  layout();
}

function layout() {
  R = min(width, height) * 0.38;
  cx = width / 2;
  cy = height / 2;
}

function buildArm() {
  arm = [];
  const N = 14;
  const a = radians(60);
  const branches = [[4, 3], [7, 4], [10, 3], [13, 2]];
  for (let i = 1; i <= N; i++) arm.push({ x: i / N, y: 0, s: i === N ? 1.6 : 1.0 });
  for (const [idx, count] of branches) {
    for (let k = 1; k <= count; k++) {
      const x = (idx + k * cos(a)) / N;
      const y = (k * sin(a)) / N;
      const s = k === count ? 1.3 : 0.85;
      arm.push({ x, y, s });
      arm.push({ x, y: -y, s });
    }
  }
}

